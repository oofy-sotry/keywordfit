# 키 이름만 둔다. 실제 값은 .env.local에 (커밋 금지). 발급 방법: docs/api-keys.md

# 공공데이터포털 일반 인증키 (Decoding)
DATA_GO_KR_SERVICE_KEY=

# 통계청 KOSIS OpenAPI 인증키
KOSIS_API_KEY=

# Gemini (Google AI Studio 무료 키)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_DAILY_LIMIT=100
AI_PER_CLIENT_DAILY_LIMIT=20

# Supabase (서버 전용 secret 키)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
